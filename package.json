{
  "name": "nexttuesday-art-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test --grep-invert \"@slow|@perf|@visual\"",
    "test:publish": "playwright test",
    "test:perf": "playwright test --project=perf",
    "test:visual": "playwright test --project=visual",
    "test:update-visual": "playwright test --project=visual --update-snapshots",
    "test:live": "NTS_BASE=https://nexttuesday.art playwright test --project=live",
    "fonts": "node tools/fonts.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
